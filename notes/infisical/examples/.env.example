# Copy to .env next to docker-compose.yml, then replace every placeholder.
#   cp .env.example .env && chmod 600 .env
# Do not commit .env. Do not reuse the sample ENCRYPTION_KEY / AUTH_SECRET below.

# Pin a release tag from https://hub.docker.com/r/infisical/infisical/tags
# Example shape: v0.166.3 — never use latest
INFISICAL_IMAGE_TAG=vX.Y.Z

# Absolute public URL including the scheme.
# First boot on the host: http://127.0.0.1:18080
# After Nginx + certbot:  https://infisical.example.com
SITE_URL=https://infisical.example.com

# 16-byte hex = exactly 32 hex characters.
# Generate on the target host: openssl rand -hex 16
# Wrong length/format → RangeError: Invalid key length at KMS startup
# Losing this value makes encrypted secrets unrecoverable.
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef

# 32-byte base64. Generate on the target host: openssl rand -base64 32
# Do not put this value into ENCRYPTION_KEY.
AUTH_SECRET=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# Docker-network DNS names, not localhost and not the host-published port.
# Replace postgresql / redis with the aliases on shared-network.
DB_CONNECTION_URI=postgres://db_user:db_password@postgresql:5432/infisical
REDIS_URL=redis://:password@redis:6379

# Optional. Missing SMTP logs errors; the core UI and API still work.
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=infisical@example.com
SMTP_FROM_NAME=Infisical
